    "die Einheit g/mol"
  ],
  "worterklaerungen": {
    "molare Masse": "Die Masse von einem Mol eines Stoffes, angegeben in g/mol.",
    "Molekülmasse": "Die Summe der Atommassen aller Atome eines Moleküls."
  },
  "can_do": {
    "A": "Ich lese Atommassen ab und addiere sie zur Molekülmasse.",
    "B": "Ich berechne molare Massen auch bei Formeln mit Klammern.",
    "C": "Ich berechne Massenanteile einzelner Elemente in einer Verbindung."
  },
  "lernkarten": {
    "A": {
      "titel": "Massen zusammenzählen",
      "hinfuehrung": "Jedes Element hat eine Atommasse.",
      "erklaerung": [
        "Sie steht im Periodensystem.",
        "Für ein Molekül werden alle addiert."
      ],
      "merke": "Molekülmasse = Summe aller Atommassen.",
      "beispiel": {
        "titel": "Wasser",
        "aufgabe": "M(H₂O) = ?",
        "schritte": [
          "2 · 1 = 2",
          "1 · 16 = 16",
          "2 + 16 = 18"
        ],
        "ergebnis": "18 g/mol",
        "luecke": {
          "schritt": 2,
          "wert": 18
        }
      },
      "visual": {
        "type": "pse",
        "markiert": [
          "H",
          "O"
        ],
        "perioden": 3,
        "alt": "Periodensystem-Ausschnitt mit Wasserstoff und Sauerstoff."
      }
    },
    "B": {
      "titel": "Molare Masse berechnen",
      "hinfuehrung": "Die molare Masse ist zahlengleich zur Molekülmasse, trägt aber die Einheit g/mol. Damit wird aus einer Verhältniszahl eine wägbare Größe.",
      "erklaerung": [
        "Für jedes Element die Atommasse ablesen und mit dem Index multiplizieren.",
        "Alles addieren. Das Ergebnis ist die molare Masse in g/mol.",
        "Bei Klammern gilt der Index für alles in der Klammer: Ca(OH)₂ = 40 + 2 · (16 + 1) = 74 g/mol.",
        "Schulwerte: H 1 · C 12 · N 14 · O 16 · Na 23 · Mg 24 · S 32 · Cl 35,5 · Ca 40 · Fe 56 · Cu 64."
      ],
      "merke": "M = Summe aller Atommassen · Indizes, in g/mol.",
      "visual": {
        "type": "lewis",
        "molekuel": "co2",
        "formel": "CO2",
        "alt": "Lewis-Formel von Kohlenstoffdioxid."
      }
    },
    "C": {
      "titel": "Massenanteile bestimmen",
      "hinfuehrung": "Aus der molaren Masse folgt unmittelbar, welcher Anteil der Masse auf welches Element entfällt — das ist die Grundlage jeder Gehaltsangabe.",
      "erklaerung": [
        "Anteil eines Elements = (Zahl der Atome · Atommasse) : molare Masse · 100 %.",
        "Beispiel Wasser: Sauerstoff 16 : 18 = 88,9 %. Obwohl zwei H-Atome enthalten sind, tragen sie nur 11,1 % der Masse.",
        "Daraus folgt eine wichtige Unterscheidung: Das Anzahlverhältnis (2 : 1) und das Massenverhältnis (1 : 8) sind zwei verschiedene Dinge.",
        "Umgekehrt lässt sich aus gemessenen Massenanteilen die Formel bestimmen — das Verfahren der Elementaranalyse."
      ],
      "merke": "Anzahlverhältnis und Massenverhältnis sind nicht dasselbe.",
      "visual": {
        "type": "anteil",
        "titel": "Massenanteile im Wasser",
        "segmente": [
          {
            "anteil": 88.9,
            "label": "O"
          },
          {
            "anteil": 11.1,
            "label": "H"
          }
        ],
        "alt": "Im Wasser entfallen 88,9 % der Masse auf Sauerstoff."
      }
    }
  },
  "formelkarte": {
    "formeln": [
      "M = Summe der Atommassen · Indizes",
      "w(Element) = n · M(Element) : M(Verbindung) · 100 %"
    ],
    "saetze": [
      "H 1 · C 12 · N 14 · O 16 · Na 23 · Mg 24 · S 32 · Cl 35,5 · Ca 40 · Fe 56 · Cu 64",
      "M(H₂O) = 18 · M(CO₂) = 44 · M(H₂SO₄) = 98 g/mol",
      "Bei Klammern gilt der Index für alles darin.",
      "Anzahlverhältnis und Massenverhältnis sind verschieden."
    ]
  },
