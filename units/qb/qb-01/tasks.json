  "tasks": [
    {
      "id": "QB01-A1-001",
      "path": "A",
      "step": 1,
      "type": "numeric",
      "prompt": "Wie groß ist die molare Masse von Wasser H₂O? (H = 1, O = 16 g/mol)",
      "answer": 18,
      "unit_label": "g/mol",
      "tolerance": 0,
      "hints": [
        "Zwei H und ein O.",
        "2 · 1 + 16.",
        "18 g/mol."
      ],
      "solution": "M(H₂O) = 2 · 1 + 16 = 18 g/mol",
      "misconceptions": [
        {
          "id": "index_uebersehen",
          "value": 17,
          "feedback": "Der Index 2 gilt für den Wasserstoff: 2 · 1 = 2.",
          "konzeptfehler": "summenformel_falsch_gelesen"
        }
      ],
      "tags": [
        "molmasse"
      ],
      "spiral": [
        "W-RECH"
      ]
    },
    {
      "id": "QB01-A2-002",
      "path": "A",
      "step": 2,
      "type": "numeric",
      "prompt": "Wie groß ist M(CO₂)? (C = 12, O = 16 g/mol)",
      "answer": 44,
      "unit_label": "g/mol",
      "tolerance": 0,
      "hints": [
        "Ein C und zwei O.",
        "12 + 2 · 16.",
        "44 g/mol."
      ],
      "solution": "M(CO₂) = 12 + 32 = 44 g/mol",
      "tags": [
        "molmasse"
      ],
      "spiral": [
        "W-RECH"
      ]
    },
