        {
          "label": "M(NH₃)",
          "answer": 17,
          "unit_label": "g/mol",
          "tolerance": 0
        },
        {
          "label": "M(SO₃)",
          "answer": 80,
          "unit_label": "g/mol",
          "tolerance": 0
        },
        {
          "label": "M(Fe₂O₃)",
          "answer": 160,
          "unit_label": "g/mol",
          "tolerance": 0
        }
      ],
      "hints": [
        "Jeden Index einzeln beachten.",
        "SO₃ = 32 + 3 · 16.",
        "Fe₂O₃ = 2 · 56 + 3 · 16."
      ],
      "solution": "NH₃ = 14 + 3 = 17\nSO₃ = 32 + 48 = 80\nFe₂O₃ = 112 + 48 = 160 g/mol",
