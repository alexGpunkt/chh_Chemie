{
  "unit": "QB-01",
  "title": "Atommasse, Molekülmasse, molare Masse",
  "leitidee": "B1",
  "standards": [
    "K1",
    "K2.4"
  ],
  "klasse": 9,
  "wortspeicher": [
    "die Atommasse",
    "die Molekülmasse",
    "die molare Masse",
