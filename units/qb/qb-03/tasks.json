  ],
  "klasse": 9,
  "wortspeicher": [
    "die Stoffmenge",
    "die molare Masse",
    "die Masse",
    "das Umstellen",
    "die Einheitenkontrolle"
  ],
  "worterklaerungen": {
    "Einheitenkontrolle": "Die Prüfung, ob die Einheit des Ergebnisses zur gesuchten Größe passt."
  },
  "can_do": {
    "A": "Ich berechne die Stoffmenge aus Masse und molarer Masse.",
    "B": "Ich stelle die Formel nach jeder der drei Größen um.",
    "C": "Ich löse mehrschrittige Aufgaben und prüfe das Ergebnis über die Einheiten."
  },
  "lernkarten": {
    "A": {
      "titel": "Eine Formel, drei Größen",
      "hinfuehrung": "n = m : M verbindet drei Größen.",
      "erklaerung": [
        "m ist die Masse in Gramm.",
        "M ist die molare Masse in g/mol.",
        "n ist die Stoffmenge in mol."
      ],
      "merke": "Zwei Größen bekannt → die dritte lässt sich ausrechnen.",
      "beispiel": {
        "titel": "Ein Beispiel",
        "aufgabe": "44 g CO₂, M = 44 g/mol.",
        "schritte": [
          "n = m : M",
          "n = 44 : 44",
          "n = 1 mol"
        ],
        "ergebnis": "1 mol",
        "luecke": {
          "schritt": 2,
          "wert": 1,
          "einheit": "mol"
        }
      },
      "visual": {
        "type": "animation",
        "name": "mol",
        "stufe": "A"
      }
    },
    "B": {
      "titel": "Die Formel umstellen",
      "hinfuehrung": "Aus einer Formel werden drei, wenn man sie umstellen kann. Welche gesucht ist, verrät die Einheit in der Frage.",
      "erklaerung": [
        "Gesucht n (in mol): n = m : M",
        "Gesucht m (in g): m = n · M",
        "Gesucht M (in g/mol): M = m : n",
        "Kontrolle über die Einheiten: g geteilt durch g/mol ergibt mol. Passt die Einheit nicht, ist die Formel falsch umgestellt."
      ],
      "merke": "Die Einheit der Frage sagt, welche Größe gesucht ist.",
      "visual": {
        "type": "animation",
        "name": "mol",
        "stufe": "B"
      }
    },
    "C": {
      "titel": "Mehrschrittig rechnen",
      "hinfuehrung": "Sobald zwei Stoffe beteiligt sind, führt der Weg immer über dieselben vier Schritte.",
      "erklaerung": [
        "1. Gegebene Masse in Stoffmenge umrechnen: n = m : M.",
        "2. Über die Koeffizienten der Reaktionsgleichung zur Stoffmenge des gesuchten Stoffes.",
        "3. Zurück zur Masse: m = n · M.",
        "4. Ergebnis prüfen: Passt die Einheit? Ist die Größenordnung plausibel?",
        "Der häufigste Fehler ist, Schritt 2 zu überspringen und Massen direkt zu übertragen — die Koeffizienten gelten aber für Teilchen, nicht für Gramm."
      ],
      "merke": "Masse → Stoffmenge → Gleichung → Stoffmenge → Masse.",
      "visual": {
        "type": "animation",
        "name": "mol",
        "stufe": "C"
      }
    }
  },
  "formelkarte": {
    "formeln": [
      "n = m : M",
      "m = n · M",
      "M = m : n"
    ],
    "saetze": [
      "Einheiten: m in g, M in g/mol, n in mol.",
      "g : (g/mol) = mol — die Einheitenkontrolle deckt Umstellfehler auf.",
      "Bei zwei Stoffen immer über die Stoffmenge rechnen.",
      "Massen dürfen nie direkt über die Gleichung übertragen werden."
    ]
  },
