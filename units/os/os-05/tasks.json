      "step": 2,
      "type": "choice",
      "prompt": "Warum reagiert Ethanol neutral, Essigsäure aber sauer?",
      "options": [
        "Nur in der Carboxygruppe wird die O–H-Bindung durch die benachbarte Doppelbindung geschwächt.",
        "Ethanol hat kein Wasserstoffatom.",
        "Essigsäure ist konzentrierter."
      ],
      "answer": 0,
      "hints": [
        "Beide haben eine OH-Gruppe.",
        "Verschieden ist die Nachbarschaft.",
        "Die C=O-Doppelbindung macht den Unterschied."
      ],
      "solution": "Die benachbarte Doppelbindung zum Sauerstoff zieht Elektronen ab und schwächt die Bindung zum Wasserstoff. Nur dann kann das Proton abgegeben werden.",
      "tags": [
        "pruefung",
        "msa"
      ],
      "spiral": [
        "W-ORG"
      ]
    },
    {
