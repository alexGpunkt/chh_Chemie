    {
      "id": "OS05-C4-014",
      "path": "C",
      "step": 4,
      "type": "choice",
      "prompt": "Ein Schüler sagt: „Konzentrierte Essigsäure ist eine starke Säure.“ Wie bewertest du das?",
      "options": [
        "Falsch — stark und konzentriert sind zwei verschiedene Begriffe; Essigsäure bleibt schwach.",
        "Richtig.",
        "Falsch — Essigsäure ist gar keine Säure."
      ],
      "answer": 0,
      "hints": [
        "Was bedeutet „stark“?",
        "Wie vollständig Protonen abgegeben werden.",
        "Konzentriert sagt nur, wie viel Stoff da ist."
      ],
      "solution": "„Stark“ beschreibt, wie vollständig eine Säure ihre Protonen abgibt — das ist eine Stoffeigenschaft. „Konzentriert“ beschreibt, wie viel Stoff je Volumen vorliegt. Konzentrierte Essigsäure ist ätzend, aber chemisch weiterhin eine schwache Säure.",
      "misconceptions": [
        {
          "id": "staerke_und_konzentration",
          "value": 1,
          "feedback": "Stärke ist eine Stoffeigenschaft, Konzentration eine Mengenangabe."
        }
