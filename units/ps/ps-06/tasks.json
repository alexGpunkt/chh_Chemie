  },
  "can_do": {
    "A": "Ich lese die Atommasse aus dem Periodensystem ab.",
    "B": "Ich berechne die Masse eines Moleküls aus den Atommassen.",
    "C": "Ich erkläre, warum relative Atommassen ohne Einheit angegeben werden."
  },
  "lernkarten": {
    "A": {
      "titel": "Zahlen im Periodensystem",
      "hinfuehrung": "Unter jedem Symbol steht eine Zahl.",
      "erklaerung": [
        "Sie sagt, wie schwer ein Atom ist.",
        "Man liest sie einfach ab."
      ],
      "merke": "Die Atommasse steht im Periodensystem.",
      "beispiel": {
        "titel": "Wasser wiegen",
        "aufgabe": "Wie schwer ist ein Wassermolekül H₂O?",
        "schritte": [
          "2 · 1 für die zwei H",
          "1 · 16 für das O",
          "2 + 16 = 18"
        ],
        "ergebnis": "18",
        "luecke": {
          "schritt": 2,
          "wert": 18
        }
      },
      "visual": {
        "type": "pse",
        "markiert": [
          "O",
          "C"
        ],
        "perioden": 3,
        "alt": "Periodensystem-Ausschnitt mit Kohlenstoff und Sauerstoff."
      }
    },
    "B": {
      "titel": "Massen zusammenzählen",
      "hinfuehrung": "Die Masse eines Moleküls ist die Summe der Massen seiner Atome. Es geht keine Masse verloren, wenn Atome sich verbinden — das ist dieselbe Aussage wie die Massenerhaltung, nur auf ein Teilchen bezogen.",
      "erklaerung": [
        "Für jedes Elementsymbol die Atommasse aus dem PSE ablesen.",
        "Mit dem Index multiplizieren: H₂ heißt 2 · 1.",
        "Alles addieren. Das Ergebnis ist die Molekülmasse.",
        "Für die Schule wird gerundet: H = 1, C = 12, N = 14, O = 16, S = 32."
      ],
      "merke": "Molekülmasse = Summe aller Atommassen, jede mit ihrem Index.",
      "visual": {
        "type": "lewis",
        "molekuel": "h2o",
        "formel": "H2O",
        "alt": "Lewis-Formel von Wasser."
      }
    },
    "C": {
      "titel": "Warum ohne Einheit",
      "hinfuehrung": "Die Masse eines einzelnen Atoms ist unvorstellbar klein — ein Wasserstoffatom wiegt rund 0,0000000000000000000000017 g. Mit solchen Zahlen lässt sich nicht arbeiten.",
      "erklaerung": [
        "Deshalb wird verglichen statt gewogen: Als Bezug dient ein Zwölftel der Masse eines Kohlenstoff-12-Atoms.",
        "Ein Sauerstoffatom ist 16-mal so schwer wie diese Einheit. Seine relative Atommasse ist 16 — eine Verhältniszahl ohne Einheit.",
        "Dieselben Zahlen erscheinen später als molare Masse in g/mol wieder. Das ist kein Zufall, sondern der eigentliche Sinn des Mol-Begriffs."
      ],
      "merke": "Relative Atommasse: ein Verhältnis, keine Masse. Deshalb ohne Einheit.",
      "visual": {
        "type": "pse",
        "markiert": [
          "C"
        ],
        "perioden": 3,
        "legende": "Kohlenstoff-12 ist der Bezugspunkt aller Atommassen.",
        "alt": "Periodensystem-Ausschnitt mit hervorgehobenem Kohlenstoff."
      }
    }
  },
  "formelkarte": {
    "formeln": [
      "Molekülmasse = Summe der Atommassen · Indizes"
